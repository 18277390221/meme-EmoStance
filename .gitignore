# Local credentials; keep example configuration available for collaborators.
.env
.env.*
!.env.example
!.env.sample

# Python environments and generated files.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.log

# Machine-specific diagnostic output.
/zerotier_chat/windows_zerotier_public_status.json
/zerotier_chat/windows_zerotier_network.json

# Local network identities and SSH host records.
/zerotier_chat/network.env
/zerotier_chat/.ssh_known_hosts

# Reproducible datasets are published below model/git_assets/ when oversized.
/dataset/*/backups/
/dataset/**/*.7z
/dataset/V2.0.0/cleaned_dialogues.jsonl
/data_spilt/V2.0.0/train.jsonl
/data_spilt/V2.0.0/dialogues/train.jsonl
/data_spilt/V2.0.0/annotation_rows/train.jsonl

# Restore duplicated archive data with model/tools/restore_git_assets.py.
/model_canshu/*/data/train.jsonl

# Trained binary weights exceed GitHub's ordinary Git file limit.
/model_canshu/**/*.pt

# Raspberry Pi runtime ASR selection stays on the installed device.
/meme_software/player/desktop/asr-selection.json

# Model weights and generated numeric artifacts are local, including small ones.
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.tflite
*.gguf
*.ggml
*.npz
*.npy
*.egg-info/
.cache/
.mypy_cache/
.ruff_cache/

# Runtime state, private reports and machine-bound release evidence.
/model_qwen/backbones/
/model_qwen/runs/
/model_qwen/logs/
/model_qwen/quality/
/model_qwen/inference_config.json
/model_information*/runs/
/model_information_qwen_3.0/inference_config.json
/model_information_qwen_3.0/inference_release.json
/model_information_qwen*/dialogue_policy.json
/model_information_qwen*/dialogue_policy_release.json
*.pid
*.lock
backups/
.deploy-backups/
speech-config.json
asr-selection.json

# Local installers and diagnostic archives.
/zerotier_chat/*.msi
/zerotier_chat/*.tar.gz
